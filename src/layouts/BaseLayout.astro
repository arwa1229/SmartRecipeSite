---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import LogoMark from '../components/LogoMark.astro';
import { dirFor, localePath, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Path of the current page without locale prefix, e.g. "/" or "/contact" */
  currentPath: string;
}

const { locale, title, description, currentPath } = Astro.props;
const t = useTranslations(locale);
const dir = dirFor[locale];

const pageTitle = title
  ? `${title} — ${t('site.name')}`
  : `${t('site.name')} — ${t('site.tagline')}`;
const pageDescription = description ?? t('site.description');

const otherLocale: Locale = locale === 'en' ? 'ar' : 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = localePath(locale, '/');

const sectionLinks = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#products`, label: t('nav.products') },
  { href: `${home}#why`, label: t('nav.why') },
];
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0a0d0c" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=Tajawal:wght@400;500;700;800&display=swap"
    />
    <link rel="alternate" hreflang="en" href={localePath('en', currentPath)} />
    <link rel="alternate" hreflang="ar" href={localePath('ar', currentPath)} />
  </head>
  <body class="bg-night text-fg min-h-screen font-sans antialiased">
    <div
      id="scroll-progress"
      class="fixed top-0 start-0 z-[70] h-[3px] w-0 rounded-e-full"
      style="background: linear-gradient(90deg, #00bfa5, #66e0cf); box-shadow: 0 0 12px rgba(0, 191, 165, 0.5);"
      aria-hidden="true"
    >
    </div>
    <header
      class="bg-night/80 sticky top-0 z-50 border-b border-white/5 backdrop-blur-md"
    >
      <div
        class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6"
      >
        <a href={home} class="shrink-0">
          <Logo variant="dark" />
        </a>
        <nav class="flex items-center gap-0.5 sm:gap-1" aria-label="Main">
          {
            sectionLinks.map((item) => (
              <a
                href={item.href}
                class="text-muted hover:text-fg hidden rounded-lg px-3 py-2 text-sm font-medium transition-colors md:block"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={localePath(otherLocale, currentPath)}
            class="hover:border-brand/60 hover:text-brand-light ms-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold transition-colors"
            lang={otherLocale}
            dir={dirFor[otherLocale]}
          >
            {t('nav.langSwitch')}
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-white/5 bg-black/40">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-14 text-center sm:px-6"
      >
        <LogoMark class="h-16" />
        <Logo variant="dark" class="scale-110" />
        <p class="text-brand-light text-sm font-medium">
          {t('site.name')} — {t('footer.slogan')}
        </p>
        <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          {
            [...sectionLinks, { href: localePath(locale, '/contact'), label: t('nav.contact') }].map(
              (item) => (
                <a
                  href={item.href}
                  class="hover:text-fg text-sm text-white/50 transition-colors"
                >
                  {item.label}
                </a>
              )
            )
          }
        </nav>
        <p class="text-xs text-white/35">
          © {new Date().getFullYear()} {t('site.name')}. {t('footer.rights')}
        </p>
      </div>
    </footer>

    <script>
      // Scroll-reveal engine: .reveal elements animate in when they enter view.
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      }

      const reduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      // Scroll progress bar
      const bar = document.getElementById('scroll-progress');
      // Parallax: [data-parallax] elements shift relative to viewport center
      type PItem = { el: HTMLElement; speed: number; center: number };
      let pitems: PItem[] = [];
      const measure = () => {
        pitems = Array.from(
          document.querySelectorAll<HTMLElement>('[data-parallax]')
        ).map((el) => {
          el.style.transform = '';
          const rect = el.getBoundingClientRect();
          return {
            el,
            speed: parseFloat(el.dataset.parallax || '0.08'),
            center: rect.top + window.scrollY + rect.height / 2,
          };
        });
      };

      let ticking = false;
      const update = () => {
        ticking = false;
        const y = window.scrollY;
        if (bar) {
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.width = max > 0 ? `${(y / max) * 100}%` : '0%';
        }
        if (reduced) return;
        const viewCenter = y + innerHeight / 2;
        for (const item of pitems) {
          const offset = (item.center - viewCenter) * item.speed;
          item.el.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
        }
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };
      if (!reduced) measure();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener(
        'resize',
        () => {
          if (!reduced) measure();
          onScroll();
        },
        { passive: true }
      );
      update();
    </script>
  </body>
</html>
