---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { dirFor, localePath, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Path of the current page without locale prefix, e.g. "/" or "/contact" */
  currentPath: string;
}

const { locale, title, description, currentPath } = Astro.props;
const t = useTranslations(locale);
const dir = dirFor[locale];

const pageTitle = title
  ? `${title} — ${t('site.name')}`
  : `${t('site.name')} — ${t('site.tagline')}`;
const pageDescription = description ?? t('site.description');

const otherLocale: Locale = locale === 'en' ? 'ar' : 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = localePath(locale, '/');

const sectionLinks = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#products`, label: t('nav.products') },
  { href: `${home}#why`, label: t('nav.why') },
];
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;500;600&family=Tajawal:wght@400;500;700;800&display=swap"
    />
    <link rel="alternate" hreflang="en" href={localePath('en', currentPath)} />
    <link rel="alternate" hreflang="ar" href={localePath('ar', currentPath)} />
  </head>
  <body class="bg-offwhite text-ink min-h-screen font-sans antialiased">
    <header
      class="sticky top-0 z-50 border-b border-black/5 bg-white/85 backdrop-blur-md"
    >
      <div
        class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6"
      >
        <a href={home} class="shrink-0">
          <Logo />
        </a>
        <nav class="flex items-center gap-0.5 sm:gap-1" aria-label="Main">
          {
            sectionLinks.map((item) => (
              <a
                href={item.href}
                class="text-muted hover:text-ink hidden rounded-lg px-3 py-2 text-sm font-medium transition-colors md:block"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={localePath(locale, '/contact')}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              currentPath === '/contact'
                ? 'text-brand-deep'
                : 'text-muted hover:text-ink',
            ]}
          >
            {t('nav.contact')}
          </a>
          <a
            href={localePath(otherLocale, currentPath)}
            class="border-ink/15 hover:border-brand hover:text-brand-deep ms-2 rounded-full border px-4 py-2 text-sm font-semibold transition-colors"
            lang={otherLocale}
            dir={dirFor[otherLocale]}
          >
            {t('nav.langSwitch')}
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-ink mt-24 text-white">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-12 text-center sm:px-6"
      >
        <Logo variant="dark" />
        <p class="text-brand-light text-sm font-medium">
          {t('site.name')} — {t('footer.slogan')}
        </p>
        <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          {
            [...sectionLinks, { href: localePath(locale, '/contact'), label: t('nav.contact') }].map(
              (item) => (
                <a
                  href={item.href}
                  class="text-sm text-white/60 transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              )
            )
          }
        </nav>
        <p class="text-xs text-white/40">
          © {new Date().getFullYear()} {t('site.name')}. {t('footer.rights')}
        </p>
      </div>
    </footer>

    <script>
      // Scroll-reveal engine: .reveal elements animate in when they enter view.
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
