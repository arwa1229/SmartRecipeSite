---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import MartinMark from '../components/MartinMark.astro';
import YelgaMark from '../components/YelgaMark.astro';
import { localePath, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const products = [
  {
    app: 'martin' as const,
    name: t('products.martin.name'),
    tag: t('products.martin.tag'),
    body: t('products.martin.body'),
    float: 'float-slow',
    href: undefined as string | undefined,
    linkLabel: undefined as string | undefined,
  },
  {
    app: 'yelga' as const,
    name: t('products.yelga.name'),
    tag: t('products.yelga.tag'),
    body: t('products.yelga.body'),
    float: 'float-slower',
    href: 'https://yelga.ai',
    linkLabel: 'yelga.ai',
  },
];

const whyItems = [
  { title: t('why.1.title'), body: t('why.1.body'), icon: 'chip' },
  { title: t('why.2.title'), body: t('why.2.body'), icon: 'shape' },
  { title: t('why.3.title'), body: t('why.3.body'), icon: 'bolt' },
];
---

<BaseLayout locale={locale} currentPath="/">
  <!-- Cinematic intro — plays once per session, skipped for reduced motion -->
  <div class="sr-intro" id="sr-intro" aria-hidden="true">
    <div class="sr-intro-inner">
      <span class="sr-intro-bar b1"></span>
      <span class="sr-intro-row">
        <span class="sr-intro-dot"></span>
        <span class="sr-intro-bar b2"></span>
      </span>
      <span class="sr-intro-bar b3"></span>
      <p class="sr-intro-word">SMART&nbsp;RECIPE</p>
    </div>
  </div>
  <script is:inline>
    (function () {
      try {
        var intro = document.getElementById('sr-intro');
        if (!intro) return;
        if (sessionStorage.getItem('srIntroSeen')) {
          intro.remove();
        } else {
          sessionStorage.setItem('srIntroSeen', '1');
          document.body.classList.add('intro-playing');
          setTimeout(function () {
            document.body.classList.remove('intro-playing');
            intro.remove();
          }, 2400);
        }
      } catch (e) {
        /* storage unavailable — let the pure-CSS animation run */
      }
    })();
  </script>

  <!-- ============ Hero ============ -->
  <section class="relative overflow-hidden">
    <!-- glow field -->
    <div
      class="absolute inset-x-0 top-0 -z-10 h-[560px]"
      style="background: radial-gradient(60% 55% at 50% 0%, rgba(0, 191, 165, 0.14), transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <div
      class="blob bg-brand/15 absolute -top-24 -end-24 -z-10 size-96 rounded-full blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="blob bg-brand-light/10 absolute top-56 -start-32 -z-10 size-105 rounded-full blur-3xl"
      style="animation-delay: -7s"
      aria-hidden="true"
    >
    </div>
    <div
      class="hero-grid absolute inset-0 -z-10"
      data-parallax="0.12"
      aria-hidden="true"
    >
    </div>
    <canvas
      id="hero-particles"
      class="absolute inset-0 -z-10 h-full w-full"
      aria-hidden="true"></canvas>

    <div class="mx-auto max-w-6xl px-4 pt-20 pb-24 text-center sm:px-6 sm:pt-28 sm:pb-32">
      <p
        class="hero-in text-brand font-heading text-sm font-semibold tracking-[0.35em] uppercase"
      >
        {t('hero.eyebrow')}
      </p>
      <h1
        class="hero-in font-heading mx-auto mt-6 max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-6xl"
        style="--d: 0.12s"
      >
        {t('hero.title.pre')}<span class="accent-gradient"
          >{t('hero.title.accent')}</span
        >{t('hero.title.post')}
      </h1>
      <p
        class="hero-in text-muted mx-auto mt-8 max-w-2xl text-lg sm:text-xl"
        style="--d: 0.24s"
      >
        {t('hero.body')}
      </p>
      <div
        class="hero-in mx-auto mt-10 flex w-full max-w-md flex-col items-stretch justify-center gap-4 sm:w-auto sm:max-w-none sm:flex-row"
        style="--d: 0.36s"
      >
        <a
          href="#products"
          class="bg-brand text-ink hover:bg-brand-light pulse-glow rounded-full px-8 py-4 text-center text-base font-semibold transition-all duration-300 hover:scale-105 sm:min-w-60"
        >
          {t('hero.cta')}
        </a>
        <a
          href={localePath(locale, '/contact')}
          class="text-fg hover:border-brand/60 hover:text-brand-light rounded-full border border-white/15 bg-white/5 px-8 py-4 text-center text-base font-semibold transition-all duration-300 hover:scale-105 sm:min-w-60"
        >
          {t('hero.ctaSecondary')}
        </a>
      </div>

      <!-- brand bar-mark motif -->
      <div
        class="hero-in mx-auto mt-16 flex w-fit flex-col gap-2"
        style="--d: 0.5s"
        data-parallax="-0.1"
        aria-hidden="true"
      >
        <span class="bg-brand h-1.5 w-16 rounded-full"></span>
        <span class="flex items-center gap-2">
          <span class="bg-fg size-3 rounded-full"></span>
          <span class="bg-fg h-1.5 w-11 rounded-full"></span>
        </span>
        <span class="bg-brand h-1.5 w-16 rounded-full"></span>
      </div>
    </div>
  </section>

  <!-- ============ About ============ -->
  <section
    id="about"
    class="bg-surface scroll-mt-20 border-y border-white/5 py-20 sm:py-28"
  >
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-12">
      <div class="reveal lg:col-span-4">
        <h2 class="font-heading text-3xl font-bold sm:text-4xl">
          {t('about.title')}
        </h2>
        <div class="mt-5 flex flex-col gap-1.5" aria-hidden="true">
          <span class="bg-brand h-1 w-12 rounded-full"></span>
          <span class="bg-brand-light h-1 w-8 rounded-full"></span>
        </div>
      </div>
      <p
        class="reveal text-muted text-lg leading-relaxed sm:text-xl lg:col-span-8"
        style="--d: 0.15s"
      >
        {t('about.body')}
      </p>
    </div>
  </section>

  <!-- ============ Products ============ -->
  <section id="products" class="relative scroll-mt-20 overflow-hidden py-20 sm:py-28">
    <div
      class="blob bg-brand/10 absolute top-40 -end-40 -z-10 size-96 rounded-full blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="reveal text-center">
        <h2 class="font-heading text-3xl font-bold sm:text-4xl">
          {t('products.title')}
        </h2>
        <p class="text-muted mt-4 text-lg">{t('products.subtitle')}</p>
      </div>

      <div class="mt-14 grid gap-8 md:grid-cols-2">
        {
          products.map((product, i) => {
            const Tag = product.href ? 'a' : 'article';
            const linkAttrs = product.href
              ? { href: product.href, target: '_blank', rel: 'noopener' }
              : {};
            return (
              <Tag
                {...linkAttrs}
                class="reveal group bg-surface relative block overflow-hidden rounded-3xl border border-white/5 p-8 transition-all duration-300 hover:-translate-y-1.5 hover:border-[#00bfa5]/40 hover:shadow-[0_0_60px_-15px_rgba(0,191,165,0.4)] sm:p-10"
                style={`--d: ${i * 0.15}s`}
              >
                <div
                  class="bg-brand/10 absolute -top-16 -end-16 size-48 rounded-full opacity-0 blur-2xl transition-opacity duration-500 group-hover:opacity-100"
                  aria-hidden="true"
                />
                <div
                  class="flex justify-center"
                  data-parallax={i === 0 ? '-0.035' : '-0.055'}
                >
                  <PhoneMockup app={product.app} class={product.float} />
                </div>
                <div class="mt-8 flex items-center gap-3">
                  {product.app === 'martin' && (
                    <MartinMark class="text-fg h-9" />
                  )}
                  {product.app === 'yelga' && (
                    <YelgaMark class="text-fg h-9" />
                  )}
                  <h3 class="font-heading text-2xl font-bold">
                    {product.name}
                  </h3>
                  {product.linkLabel && (
                    <span class="text-brand-light ms-auto inline-flex items-center gap-1.5 text-sm font-medium">
                      {product.linkLabel}
                      <svg
                        viewBox="0 0 24 24"
                        class="size-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M7 17L17 7M9 7h8v8" />
                      </svg>
                    </span>
                  )}
                </div>
                <p class="text-brand-light mt-1.5 font-medium">{product.tag}</p>
                <p class="text-muted mt-4 leading-relaxed">{product.body}</p>
              </Tag>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ============ Why Smart Recipe ============ -->
  <section
    id="why"
    class="bg-surface scroll-mt-20 border-y border-white/5 py-20 sm:py-28"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="reveal font-heading text-center text-3xl font-bold sm:text-4xl">
        {t('why.title')}
      </h2>
      <div class="mt-14 grid gap-6 sm:grid-cols-3">
        {
          whyItems.map((item, i) => (
            <div
              class="reveal bg-surface-2 rounded-3xl border border-white/5 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[#00bfa5]/30 hover:shadow-[0_0_45px_-15px_rgba(0,191,165,0.35)]"
              style={`--d: ${i * 0.15}s`}
            >
              <span class="bg-brand/10 text-brand-light inline-flex size-12 items-center justify-center rounded-2xl">
                {item.icon === 'chip' && (
                  <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="5" y="5" width="14" height="14" rx="3" />
                    <rect x="9.5" y="9.5" width="5" height="5" rx="1.5" />
                    <path d="M9 5V2m6 3V2M9 22v-3m6 3v-3M5 9H2m3 6H2m20-6h-3m3 6h-3" />
                  </svg>
                )}
                {item.icon === 'shape' && (
                  <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 7h16M4 12h10M4 17h13" />
                    <circle cx="19" cy="17" r="1.4" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {item.icon === 'bolt' && (
                  <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" />
                  </svg>
                )}
              </span>
              <h3 class="font-heading mt-5 text-xl font-bold">{item.title}</h3>
              <p class="text-muted mt-3 leading-relaxed">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ Contact CTA ============ -->
  <section id="contact" class="scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
    <div
      class="reveal bg-surface relative mx-auto max-w-6xl overflow-hidden rounded-3xl border border-white/5 px-6 py-20 text-center sm:px-12"
    >
      <div
        class="blob bg-brand/20 absolute -top-20 -start-20 size-72 rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="blob bg-brand-light/15 absolute -bottom-24 -end-16 size-72 rounded-full blur-3xl"
        style="animation-delay: -6s"
        aria-hidden="true"
      >
      </div>
      <h2
        class="font-heading relative mx-auto max-w-2xl text-3xl font-bold text-balance sm:text-5xl"
      >
        {t('contact.section.title')}
      </h2>
      <a
        href={localePath(locale, '/contact')}
        class="bg-brand text-ink hover:bg-brand-light pulse-glow relative mt-10 inline-block rounded-full px-9 py-4 text-base font-semibold transition-all duration-300 hover:scale-105"
      >
        {t('contact.section.cta')}
      </a>
    </div>
  </section>

  <script>
    // Drifting teal particle field in the hero.
    const canvas = document.getElementById(
      'hero-particles'
    ) as HTMLCanvasElement | null;
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (canvas && !reducedMotion) {
      const ctx = canvas.getContext('2d');
      const hero = canvas.parentElement as HTMLElement;
      const COLORS = ['0, 191, 165', '102, 224, 207'];
      type P = {
        x: number;
        y: number;
        r: number;
        a: number;
        vy: number;
        sway: number;
        phase: number;
        color: string;
      };
      let parts: P[] = [];
      let w = 0;
      let h = 0;
      let raf = 0;

      const spawn = (): P => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: 0.8 + Math.random() * 1.6,
        a: 0.12 + Math.random() * 0.35,
        vy: 0.12 + Math.random() * 0.28,
        sway: 0.2 + Math.random() * 0.5,
        phase: Math.random() * Math.PI * 2,
        color: COLORS[Math.floor(Math.random() * COLORS.length)],
      });

      const resize = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = hero.clientWidth;
        h = hero.clientHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
        const count = Math.min(70, Math.round((w * h) / 22000));
        parts = Array.from({ length: count }, spawn);
      };

      let t = 0;
      const tick = () => {
        if (!ctx) return;
        t += 0.008;
        ctx.clearRect(0, 0, w, h);
        for (const p of parts) {
          p.y -= p.vy;
          if (p.y < -6) {
            p.y = h + 6;
            p.x = Math.random() * w;
          }
          const x = p.x + Math.sin(t * 2 + p.phase) * p.sway * 14;
          ctx.beginPath();
          ctx.arc(x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${p.color}, ${p.a})`;
          ctx.fill();
        }
        raf = requestAnimationFrame(tick);
      };

      // Only animate while the hero is on screen and the tab is visible
      const start = () => {
        if (!raf) raf = requestAnimationFrame(tick);
      };
      const stop = () => {
        cancelAnimationFrame(raf);
        raf = 0;
      };
      new IntersectionObserver((entries) => {
        entries[0].isIntersecting && !document.hidden ? start() : stop();
      }).observe(hero);
      document.addEventListener('visibilitychange', () =>
        document.hidden ? stop() : start()
      );
      window.addEventListener('resize', resize, { passive: true });

      resize();
      start();
    }
  </script>
</BaseLayout>
