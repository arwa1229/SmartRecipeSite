---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const services = [
  { title: t('services.1.title'), body: t('services.1.body') },
  { title: t('services.2.title'), body: t('services.2.body') },
  { title: t('services.3.title'), body: t('services.3.body') },
];
---

<BaseLayout locale={locale} currentPath="/">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="brand-gradient absolute inset-x-0 top-0 -z-10 h-full opacity-[0.06]"></div>
    <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6 sm:py-28">
      <p class="mb-4 text-sm font-semibold tracking-widest text-brand-dark uppercase">
        {t('site.tagline')}
      </p>
      <h1 class="mx-auto max-w-3xl text-4xl font-extrabold tracking-tight text-balance sm:text-6xl">
        {t('hero.title')}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-brand">
        {t('hero.subtitle')}
      </p>
      <div class="mt-10">
        <a
          href={localePath(locale, '/contact')}
          class="brand-gradient inline-block rounded-xl px-8 py-4 text-base font-semibold text-white shadow-lg shadow-emerald-500/25 transition-transform hover:scale-105"
        >
          {t('hero.cta')}
        </a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="text-center">
      <h2 class="text-3xl font-bold sm:text-4xl">{t('services.title')}</h2>
      <p class="mt-3 text-slate-brand">{t('services.subtitle')}</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        services.map((service) => (
          <div class="rounded-2xl border border-slate-100 bg-white p-8 shadow-sm transition-shadow hover:shadow-md">
            <div class="brand-gradient mb-5 h-1.5 w-12 rounded-full" />
            <h3 class="text-xl font-bold">{service.title}</h3>
            <p class="mt-3 text-slate-brand">{service.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="brand-gradient rounded-3xl px-6 py-16 text-center text-white sm:px-12">
      <h2 class="text-3xl font-bold sm:text-4xl">{t('cta.title')}</h2>
      <p class="mx-auto mt-4 max-w-xl text-white/85">{t('cta.body')}</p>
      <a
        href={localePath(locale, '/contact')}
        class="mt-8 inline-block rounded-xl bg-white px-8 py-4 text-base font-semibold text-brand-dark transition-transform hover:scale-105"
      >
        {t('cta.button')}
      </a>
    </div>
  </section>
</BaseLayout>
