---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t('contact.title')} currentPath="/contact">
  <section class="relative overflow-hidden">
    <div
      class="blob bg-brand-light/25 absolute -top-24 -end-24 -z-10 size-80 rounded-full blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="max-w-2xl">
        <h1
          class="hero-in font-heading text-4xl font-bold tracking-tight sm:text-5xl"
        >
          {t('contact.title')}
        </h1>
        <p class="hero-in text-muted mt-4 text-lg" style="--d: 0.12s">
          {t('contact.subtitle')}
        </p>
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-5">
        <!--
          Static site: the form needs a form-backend service to actually deliver
          messages. Replace FORM_ENDPOINT with e.g. a Formspree endpoint
          (https://formspree.io) once the company account is set up.
        -->
        <form
          action="FORM_ENDPOINT"
          method="POST"
          class="hero-in space-y-5 rounded-3xl border border-black/5 bg-white p-8 shadow-sm lg:col-span-3"
          style="--d: 0.2s"
        >
          <div>
            <label for="name" class="mb-1.5 block text-sm font-semibold">
              {t('contact.form.name')}
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="focus:border-brand focus:ring-brand/25 w-full rounded-xl border border-black/10 px-4 py-3 transition-colors outline-none focus:ring-2"
            />
          </div>
          <div>
            <label for="email" class="mb-1.5 block text-sm font-semibold">
              {t('contact.form.email')}
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="focus:border-brand focus:ring-brand/25 w-full rounded-xl border border-black/10 px-4 py-3 transition-colors outline-none focus:ring-2"
            />
          </div>
          <div>
            <label for="message" class="mb-1.5 block text-sm font-semibold">
              {t('contact.form.message')}
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="focus:border-brand focus:ring-brand/25 w-full resize-y rounded-xl border border-black/10 px-4 py-3 transition-colors outline-none focus:ring-2"
            ></textarea>
          </div>
          <button
            type="submit"
            class="bg-ink hover:bg-brand hover:text-ink w-full rounded-full px-8 py-4 text-base font-semibold text-white shadow-lg transition-all duration-300 hover:scale-[1.02]"
          >
            {t('contact.form.submit')}
          </button>
        </form>

        <div class="hero-in lg:col-span-2" style="--d: 0.3s">
          <div class="bg-ink rounded-3xl p-8 text-white">
            <h2 class="font-heading text-xl font-bold">
              {t('contact.info.title')}
            </h2>
            <ul class="mt-6 space-y-4 text-white/75">
              <li class="flex items-center gap-3">
                <span class="bg-brand inline-block h-1.5 w-5 shrink-0 rounded-full"></span>
                <a
                  href={`mailto:${t('contact.info.email')}`}
                  class="hover:text-brand-light transition-colors"
                  dir="ltr"
                >
                  {t('contact.info.email')}
                </a>
              </li>
              <li class="flex items-center gap-3">
                <span class="bg-brand-light inline-block h-1.5 w-5 shrink-0 rounded-full"></span>
                <span dir="ltr">{t('contact.info.phone')}</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="inline-block h-1.5 w-5 shrink-0 rounded-full bg-white/70"></span>
                <span>{t('contact.info.address')}</span>
              </li>
            </ul>
            <p class="text-brand-light mt-8 text-sm font-medium">
              {t('site.tagline')}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
