---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// After a successful send, FormSubmit redirects back here with ?sent=1
const returnUrl = new URL(
  `${localePath(locale, '/contact')}?sent=1`,
  Astro.site
).href;
---

<BaseLayout locale={locale} title={t('contact.title')} currentPath="/contact">
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-x-0 top-0 -z-10 h-[420px]"
      style="background: radial-gradient(55% 60% at 50% 0%, rgba(0, 191, 165, 0.12), transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <div
      class="blob bg-brand/10 absolute -top-24 -end-24 -z-10 size-80 rounded-full blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="text-center">
        <h1
          class="hero-in font-heading text-4xl font-bold tracking-tight sm:text-5xl"
        >
          {t('contact.title')}
        </h1>
        <p class="hero-in text-muted mt-4 text-lg" style="--d: 0.12s">
          {t('contact.subtitle')}
        </p>
      </div>

      <div class="mt-12">
        <div
          id="form-success"
          hidden
          class="border-brand/40 bg-brand/10 text-brand-light mb-6 rounded-2xl border px-6 py-4 text-center font-medium"
        >
          {t('contact.form.success')}
        </div>
        <!-- Submissions are relayed to the company inbox via formsubmit.co -->
        <form
          action="https://formsubmit.co/arwa@martin.live"
          method="POST"
          class="hero-in bg-surface space-y-5 rounded-3xl border border-white/5 p-8 sm:p-10"
          style="--d: 0.2s"
        >
          <input type="hidden" name="_subject" value="New message from the Smart Recipe website" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value={returnUrl} />
          <input
            type="text"
            name="_honey"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="display: none"
          />
          <div>
            <label for="name" class="mb-1.5 block text-sm font-semibold">
              {t('contact.form.name')}
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="bg-night text-fg focus:border-brand focus:ring-brand/25 w-full rounded-xl border border-white/10 px-4 py-3 transition-colors outline-none focus:ring-2"
            />
          </div>
          <div>
            <label for="email" class="mb-1.5 block text-sm font-semibold">
              {t('contact.form.email')}
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="bg-night text-fg focus:border-brand focus:ring-brand/25 w-full rounded-xl border border-white/10 px-4 py-3 transition-colors outline-none focus:ring-2"
            />
          </div>
          <div>
            <label for="phone" class="mb-1.5 block text-sm font-semibold">
              {t('contact.form.phone')}
            </label>
            <input
              id="phone"
              name="phone"
              type="tel"
              dir="ltr"
              class="bg-night text-fg focus:border-brand focus:ring-brand/25 w-full rounded-xl border border-white/10 px-4 py-3 transition-colors outline-none focus:ring-2"
            />
          </div>
          <div>
            <label for="message" class="mb-1.5 block text-sm font-semibold">
              {t('contact.form.message')}
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="bg-night text-fg focus:border-brand focus:ring-brand/25 w-full resize-y rounded-xl border border-white/10 px-4 py-3 transition-colors outline-none focus:ring-2"
            ></textarea>
          </div>
          <button
            type="submit"
            class="bg-brand text-ink hover:bg-brand-light pulse-glow w-full rounded-full px-8 py-4 text-base font-semibold transition-all duration-300 hover:scale-[1.02]"
          >
            {t('contact.form.submit')}
          </button>
        </form>
      </div>
    </div>
  </section>

  <script>
    // Show the thank-you banner when returning from a successful send
    if (new URLSearchParams(location.search).has('sent')) {
      const banner = document.getElementById('form-success');
      if (banner) {
        banner.hidden = false;
        banner.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
    }
  </script>
</BaseLayout>
