---
// Yelga product mark, drawn in the same family as the Martin mark:
// a line Y whose right arm carries the teal dot with signal arcs.
// Stand-in until the official yelga.ai logo asset is provided.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 158 118"
  class:list={['h-10 w-auto', className]}
  aria-hidden="true"
>
  <polyline
    points="22,16 68,64 68,110"
    fill="none"
    stroke="currentColor"
    stroke-width="11"
    stroke-linecap="round"
    stroke-linejoin="round"></polyline>
  <line
    x1="68"
    y1="64"
    x2="106"
    y2="42"
    stroke="currentColor"
    stroke-width="11"
    stroke-linecap="round"></line>
  <circle cx="122" cy="30" r="11" fill="#129B85"></circle>
  <path
    d="M99 21 q-8 9 0 18"
    fill="none"
    stroke="currentColor"
    stroke-width="5"
    stroke-linecap="round"></path>
  <path
    d="M145 21 q8 9 0 18"
    fill="none"
    stroke="currentColor"
    stroke-width="5"
    stroke-linecap="round"></path>
</svg>
