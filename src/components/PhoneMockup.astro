---
// Stylized dark skeleton-UI phone mockups for the product cards.
// Placeholder art until real app screenshots are available.
interface Props {
  app: 'martin' | 'yelga';
  class?: string;
}

const { app, class: className } = Astro.props;
---

<svg
  viewBox="0 0 220 440"
  class:list={['h-auto w-full max-w-[200px]', className]}
  aria-hidden="true"
>
  <rect x="4" y="4" width="212" height="432" rx="34" fill="#050707" stroke="#2A322F"></rect>
  <rect x="12" y="12" width="196" height="416" rx="27" fill="#121715"></rect>
  <rect x="86" y="22" width="48" height="8" rx="4" fill="#2C3431"></rect>

  {
    app === 'martin' ? (
      <>
        {/* Martin — assistant chat skeleton */}
        <rect x="28" y="52" width="80" height="12" rx="6" fill="#E8ECEB" />
        <rect x="28" y="72" width="52" height="8" rx="4" fill="#3C4643" />
        <rect x="28" y="102" width="118" height="40" rx="14" fill="#1E2523" />
        <rect x="40" y="114" width="82" height="7" rx="3.5" fill="#5A6663" />
        <rect x="40" y="126" width="60" height="7" rx="3.5" fill="#3C4643" />
        <rect x="74" y="158" width="118" height="52" rx="14" fill="#00BFA5" />
        <rect x="86" y="170" width="84" height="7" rx="3.5" fill="#0A0D0C" opacity="0.75" />
        <rect x="86" y="182" width="66" height="7" rx="3.5" fill="#0A0D0C" opacity="0.5" />
        <rect x="86" y="194" width="44" height="7" rx="3.5" fill="#0A0D0C" opacity="0.5" />
        <rect x="28" y="226" width="98" height="40" rx="14" fill="#1E2523" />
        <rect x="40" y="238" width="66" height="7" rx="3.5" fill="#5A6663" />
        <rect x="40" y="250" width="42" height="7" rx="3.5" fill="#3C4643" />
        {/* reminder card */}
        <rect x="28" y="288" width="164" height="58" rx="14" fill="#181E1C" stroke="#2C3431" />
        <circle cx="48" cy="317" r="10" fill="#66E0CF" />
        <path d="M44 317l3 3 6-6" stroke="#0A0D0C" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="66" y="304" width="96" height="8" rx="4" fill="#E8ECEB" />
        <rect x="66" y="320" width="68" height="7" rx="3.5" fill="#3C4643" />
        {/* input bar */}
        <rect x="28" y="376" width="164" height="34" rx="17" fill="#1E2523" />
        <rect x="44" y="389" width="88" height="8" rx="4" fill="#3C4643" />
        <circle cx="175" cy="393" r="12" fill="#00BFA5" />
        <path d="M175 388v7m0 0l-3-3m3 3l3-3" stroke="#0A0D0C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="rotate(180 175 391.5)" />
      </>
    ) : (
      <>
        {/* Yelga — smart search skeleton */}
        <rect x="28" y="52" width="80" height="12" rx="6" fill="#E8ECEB" />
        <rect x="28" y="72" width="52" height="8" rx="4" fill="#3C4643" />
        {/* search pill echoing the brand slider mark */}
        <rect x="28" y="96" width="164" height="38" rx="19" fill="#1E2523" stroke="#2C3431" />
        <circle cx="49" cy="115" r="9" fill="#00BFA5" />
        <rect x="64" y="111" width="82" height="8" rx="4" fill="#5A6663" />
        <circle cx="172" cy="115" r="10" fill="#66E0CF" />
        <path d="M170 111a5 5 0 1 1-1 8m-1-2l-4 5" stroke="#0A0D0C" stroke-width="2" fill="none" stroke-linecap="round" />
        {/* result cards */}
        <rect x="28" y="152" width="164" height="64" rx="14" fill="#181E1C" stroke="#2C3431" />
        <rect x="42" y="166" width="34" height="34" rx="10" fill="#66E0CF" />
        <rect x="88" y="168" width="90" height="9" rx="4.5" fill="#E8ECEB" />
        <rect x="88" y="184" width="72" height="7" rx="3.5" fill="#5A6663" />
        <rect x="88" y="196" width="52" height="7" rx="3.5" fill="#3C4643" />
        <rect x="28" y="226" width="164" height="64" rx="14" fill="#181E1C" stroke="#2C3431" />
        <rect x="42" y="240" width="34" height="34" rx="10" fill="#00BFA5" />
        <rect x="88" y="242" width="80" height="9" rx="4.5" fill="#E8ECEB" />
        <rect x="88" y="258" width="88" height="7" rx="3.5" fill="#5A6663" />
        <rect x="88" y="270" width="46" height="7" rx="3.5" fill="#3C4643" />
        <rect x="28" y="300" width="164" height="64" rx="14" fill="#181E1C" stroke="#2C3431" />
        <rect x="42" y="314" width="34" height="34" rx="10" fill="#1E2523" />
        <rect x="88" y="316" width="86" height="9" rx="4.5" fill="#E8ECEB" />
        <rect x="88" y="332" width="64" height="7" rx="3.5" fill="#5A6663" />
        <rect x="88" y="344" width="56" height="7" rx="3.5" fill="#3C4643" />
        {/* answer chip */}
        <rect x="52" y="384" width="116" height="26" rx="13" fill="#00BFA5" />
        <rect x="72" y="393" width="76" height="8" rx="4" fill="#0A0D0C" opacity="0.75" />
      </>
    )
  }
</svg>
